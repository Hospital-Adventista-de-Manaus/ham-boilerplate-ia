{
  "model": "sonnet",
  "effortLevel": "medium",
  "permissions": {
    "deny": ["Read(**/*.har)", "Edit(**/*.har)", "Write(**/*.har)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/guard.mjs" }]
      }
    ]
  }
}
